#!/bin/bash
# sync-claude-credentials — Reconcile Claude OAuth credentials between the
# macOS Keychain and ~/.claude/.credentials.json.
#
# The container sees ~/.claude/.credentials.json directly via the bind mount,
# so there is no forwarding or tmpfs shuffling — we just keep the host file in
# sync with the Keychain before a session (so the container reads a fresh
# token) and after a session (so the host picks up a token Claude refreshed
# inside the container).
#
# The blob also holds the OAuth tokens of remote MCP servers (mcpOAuth), so the
# sync merges those per server. That lets `claude mcp login <name>` run once on
# the host and serve the container too, which has no browser for the callback.
#
# On non-macOS hosts this is a no-op: the bind-mounted file is already the
# source of truth.
#
# Sync failures are non-fatal.
#
# Usage:
#   sync-claude-credentials sync

set -uo pipefail

CREDS_FILE="$HOME/.claude/.credentials.json"
KEYCHAIN_SERVICE="Claude Code-credentials"

is_macos() {
    [ "$(uname -s)" = "Darwin" ]
}

# Merge the Keychain blob (arg 1) with the file blob (arg 2). The blob with the
# newer Claude token wins for the shared keys. mcpOAuth merges per server, so a
# login on one side survives a newer Claude token on the other side.
# Prints "<flags>\n<merged json>", where flags hold K when the Keychain is stale
# and F when the file is stale.
merge_creds() {
    python3 -c "
import json, sys

def load(raw):
    try:
        value = json.loads(raw)
    except Exception:
        return {}
    return value if isinstance(value, dict) else {}

def expires(blob, key):
    entry = blob.get(key)
    return entry.get('expiresAt', 0) if isinstance(entry, dict) else 0

keychain, file = load(sys.argv[1]), load(sys.argv[2])
newer, older = (file, keychain) if expires(file, 'claudeAiOauth') > expires(keychain, 'claudeAiOauth') else (keychain, file)
merged = {**older, **newer}

k_mcp, f_mcp = keychain.get('mcpOAuth') or {}, file.get('mcpOAuth') or {}
if k_mcp or f_mcp:
    mcp = {}
    for name in set(k_mcp) | set(f_mcp):
        if name not in k_mcp:
            mcp[name] = f_mcp[name]
        elif name not in f_mcp:
            mcp[name] = k_mcp[name]
        else:
            k_entry, f_entry = k_mcp[name], f_mcp[name]
            k_exp = k_entry.get('expiresAt', 0) if isinstance(k_entry, dict) else 0
            f_exp = f_entry.get('expiresAt', 0) if isinstance(f_entry, dict) else 0
            mcp[name] = k_entry if k_exp > f_exp else f_entry
    merged['mcpOAuth'] = mcp

flags = ''
if merged != keychain:
    flags += 'K'
if merged != file:
    flags += 'F'
print(flags)
print(json.dumps(merged))
" "$1" "$2"
}

read_keychain() {
    security find-generic-password -w -s "$KEYCHAIN_SERVICE" 2>/dev/null
}

write_keychain() {
    security delete-generic-password -s "$KEYCHAIN_SERVICE" >/dev/null 2>&1 || true
    security add-generic-password -s "$KEYCHAIN_SERVICE" -a "$USER" -w "$1" >/dev/null 2>&1
}

sync_macos() {
    mkdir -p "$(dirname "$CREDS_FILE")"

    # Migrate from the legacy /dev/shm symlink layout. Older versions of this
    # repo pointed ~/.claude/.credentials.json at a tmpfs path inside the
    # container; on the host that symlink is always broken. Remove it so the
    # write below produces a real file.
    if [ -L "$CREDS_FILE" ]; then
        rm -f "$CREDS_FILE"
    fi

    local k_json f_json result flags merged
    k_json="$(read_keychain)" || k_json=""
    f_json=""
    [ -f "$CREDS_FILE" ] && f_json="$(cat "$CREDS_FILE")"

    result="$(merge_creds "$k_json" "$f_json")" || return 1
    flags="${result%%$'\n'*}"
    merged="${result#*$'\n'}"

    if [ "$merged" = "{}" ]; then
        echo "Warning: No Claude credentials found in Keychain or $CREDS_FILE" >&2
        echo "Run 'claude' on the host to log in." >&2
        return 0
    fi

    case "$flags" in
    *K*) write_keychain "$merged" ;;
    esac

    case "$flags" in
    *F*)
        printf '%s' "$merged" >"$CREDS_FILE"
        chmod 600 "$CREDS_FILE"
        ;;
    esac
}

case "${1:-}" in
    sync)
        if [ "${CLAUDE_CREDENTIAL_SYNC:-true}" = "false" ]; then
            :
        elif is_macos; then
            sync_macos || true
        fi
        # Non-macOS: the bind-mounted file is the source of truth, nothing to do.
        ;;
    *)
        echo "Usage: sync-claude-credentials sync" >&2
        exit 1
        ;;
esac
