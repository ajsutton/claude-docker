#!/bin/bash
# sync-claude-credentials — Reconcile Claude OAuth credentials between the
# macOS Keychain and ~/.claude/.credentials.json.
#
# The container sees ~/.claude/.credentials.json directly via the bind mount,
# so there is no forwarding or tmpfs shuffling — we just keep the host file in
# sync with the Keychain before a session (so the container reads a fresh
# token) and after a session (so the host picks up a token Claude refreshed
# inside the container).
#
# On non-macOS hosts this is a no-op: the bind-mounted file is already the
# source of truth.
#
# Sync failures are non-fatal.
#
# Usage:
#   sync-claude-credentials sync

set -uo pipefail

CREDS_FILE="$HOME/.claude/.credentials.json"
KEYCHAIN_SERVICE="Claude Code-credentials"

is_macos() {
    [ "$(uname -s)" = "Darwin" ]
}

# expiresAt from a credentials JSON blob; 0 if missing/invalid/empty.
expires_at() {
    python3 -c "
import json, sys
try:
    print(json.loads(sys.argv[1]).get('claudeAiOauth', {}).get('expiresAt', 0))
except Exception:
    print(0)
" "$1"
}

read_keychain() {
    security find-generic-password -w -s "$KEYCHAIN_SERVICE" 2>/dev/null
}

write_keychain() {
    security delete-generic-password -s "$KEYCHAIN_SERVICE" >/dev/null 2>&1 || true
    security add-generic-password -s "$KEYCHAIN_SERVICE" -a "$USER" -w "$1" >/dev/null 2>&1
}

sync_macos() {
    mkdir -p "$(dirname "$CREDS_FILE")"

    # Migrate from the legacy /dev/shm symlink layout. Older versions of this
    # repo pointed ~/.claude/.credentials.json at a tmpfs path inside the
    # container; on the host that symlink is always broken. Remove it so the
    # write below produces a real file.
    if [ -L "$CREDS_FILE" ]; then
        rm -f "$CREDS_FILE"
    fi

    local k_json f_json k_exp f_exp
    k_json="$(read_keychain)" || k_json=""
    f_json=""
    [ -f "$CREDS_FILE" ] && f_json="$(cat "$CREDS_FILE")"

    k_exp="$(expires_at "$k_json")"
    f_exp="$(expires_at "$f_json")"

    if [ "$f_exp" -gt "$k_exp" ] 2>/dev/null; then
        write_keychain "$f_json"
    elif [ "$k_exp" -gt "$f_exp" ] 2>/dev/null; then
        printf '%s' "$k_json" > "$CREDS_FILE"
        chmod 600 "$CREDS_FILE"
    fi

    if [ "$k_exp" -eq 0 ] 2>/dev/null && [ "$f_exp" -eq 0 ] 2>/dev/null; then
        echo "Warning: No Claude credentials found in Keychain or $CREDS_FILE" >&2
        echo "Run 'claude' on the host to log in." >&2
    fi
}

case "${1:-}" in
    sync)
        if [ "${CLAUDE_CREDENTIAL_SYNC:-true}" = "false" ]; then
            :
        elif is_macos; then
            sync_macos || true
        fi
        # Non-macOS: the bind-mounted file is the source of truth, nothing to do.
        ;;
    *)
        echo "Usage: sync-claude-credentials sync" >&2
        exit 1
        ;;
esac
