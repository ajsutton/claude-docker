# Path to your local code directory. This will be mounted into the container
# at the same path so file references are identical inside and outside Docker.
CODE_PATH=/Users/yourname/Documents/code

# Host port that maps to SSH inside the container (default: 2222)
# SSH_PORT=2222

# Project/container name — override to run multiple instances side by side
# COMPOSE_PROJECT_NAME=claude-dev

# SSH public keys to allow into the container (space-separated or newline-separated).
# Add one key per line within the double quotes.
SSH_AUTHORIZED_KEYS="ssh-rsa AAAA...your_key_here... user@host"

# Default arguments passed to claude when running be-claude.
# CLAUDE_ARGS="--dangerously-skip-permissions"

# Default arguments passed to codex when running be-codex.
# CODEX_ARGS="--full-auto"

# Codex sandbox mode (default: danger-full-access). Bubblewrap can't create
# namespaces inside Docker, so the sandboxed modes don't work without --privileged.
# Possible values: read-only, workspace-write, danger-full-access
# CODEX_SANDBOX=danger-full-access

# Environment variables to forward into the container (space-separated names).
# Since this file is sourced as bash, you can use command substitution to set values.
FORWARD_ENVS="GH_TOKEN"
GH_TOKEN=$(gh auth token)
# For 1Password: GH_TOKEN=$(op plugin run -- gh auth token)

# Use mosh instead of SSH for resilient connections. Requires mosh to be
# installed on the host. Disabled by default; set to true to enable.
# USE_MOSH=true

# Disable automatic Claude credential sync between macOS Keychain and
# ~/.claude/.credentials.json. Set to 1 if you manage credentials manually.
# CLAUDE_CREDENTIAL_SYNC=false

# Ephemeral per-session containers. When true, each be-claude / be-codex /
# be-shell / be-exec invocation runs its own fresh container from the current
# image instead of SSHing into a long-running shared container. Concurrent
# sessions are fully isolated from each other, and rebuilding the image (via
# ./run.sh) does not disturb already-running sessions — the next session
# starts from the new image.
#
# Trade-offs — see docs/ephemeral-sessions.md for the full analysis:
# - SSH_PORT / MOSH_PORT / SSH_AUTHORIZED_KEYS / USE_MOSH are unused
# - compose.d/ overlays are NOT applied — use files/init.d/*.sh + EXTRA_VOLUMES
# - each session pays a small docker run startup cost
# - build caches shared across sessions via named Docker volumes
# EPHEMERAL_SESSIONS=false

# Override the host-side ssh-agent socket. Auto-detection covers 1Password
# (macOS + Linux), Secretive, KeePassXC, gnome-keyring, $SSH_AUTH_SOCK on
# Linux/OrbStack, and the Docker Desktop synth path on macOS. See
# lib/ssh-agent-detect.sh for the full list and priority order. Run
# `./run.sh ssh-agent-check` to see which one will be selected.
# Only set this if auto-detection picks the wrong agent.
# SSH_AGENT_HOST_SOCK=

# Extra named-volume mounts for ephemeral sessions, as "volume:path" pairs
# separated by commas. Typical use: a long-lived rust/target volume shared
# across sessions, replacing the old compose.d/rust-cache.yml overlay.
# Named volumes are created lazily by Docker on first attach. Pair with a
# files/init.d/*.sh script to chown the mount if the tool needs it
# writable as the app user — see files/init.d/rust-cache.sh.example.
# EXTRA_VOLUMES="rust-target:/Users/aj/Documents/code/optimism/rust/target"

# additional apt packages to install in the container.
# EXTRA_PACKAGES="postgresql-client redis-tools"

# additional npm packages to install in the container.
# EXTRA_NPM_PACKAGES="opencode-ai"
